{
  "family": "prism-lidar-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["EC2"],
  "cpu": "4096",
  "memory": "16384",
  "executionRoleArn": "REPLACE_WITH_ECS_TASK_EXECUTION_ROLE_ARN",
  "taskRoleArn": "REPLACE_WITH_PRISM_TASK_ROLE_ARN",
  "volumes": [
    {
      "name": "prism-jobs",
      "efsVolumeConfiguration": {
        "fileSystemId": "REPLACE_WITH_EFS_FILE_SYSTEM_ID",
        "rootDirectory": "/prism/jobs",
        "transitEncryption": "ENABLED",
        "authorizationConfig": {
          "accessPointId": "REPLACE_WITH_EFS_ACCESS_POINT_ID",
          "iam": "ENABLED"
        }
      }
    }
  ],
  "containerDefinitions": [
    {
      "name": "prism-api",
      "image": "REPLACE_WITH_ACCOUNT_ID.dkr.ecr.REPLACE_WITH_REGION.amazonaws.com/prism-api:REPLACE_WITH_TAG",
      "essential": true,
      "portMappings": [
        {"containerPort": 8000, "hostPort": 8000, "protocol": "tcp", "appProtocol": "http"}
      ],
      "resourceRequirements": [{"type": "GPU", "value": "1"}],
      "mountPoints": [
        {"sourceVolume": "prism-jobs", "containerPath": "/app/data/jobs", "readOnly": false}
      ],
      "environment": [
        {"name": "PRISM_DEVICE", "value": "cuda"},
        {"name": "PRISM_ALLOWED_ORIGINS", "value": "https://REPLACE_WITH_APPROVED_DOMAIN"}
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "python -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=4).read()\""],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 120
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/prism-lidar-api",
          "awslogs-region": "REPLACE_WITH_REGION",
          "awslogs-stream-prefix": "api",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
